rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      // The deletion lock blocks uploads before account data cleanup begins.
      return request.auth != null && request.auth.uid == userId
        && !firestore.exists(/databases/(default)/documents/accountDeletions/$(userId));
    }
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /users/{userId}/brand/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && (request.resource == null
          || (request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /users/{userId}/workouts/{workoutId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && (request.resource == null
          || (request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }
  }
}
