rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isOwner(userId) {
      // The deletion lock blocks uploads before account data cleanup begins.
      return request.auth != null && request.auth.uid == userId
        && !firestore.exists(/databases/(default)/documents/accountDeletions/$(userId));
    }
    function canCustomizeBrand(userId) {
      let path = /databases/(default)/documents/subscriptionEntitlements/$(userId);
      // Preserve installed clients until the account's v2 projection activates.
      return !firestore.exists(path)
        || firestore.get(path).data.get('policyVersion', '') != 'plan-entitlements-v2'
        || (firestore.get(path).data.get('validUntilMs', 0) > request.time.toMillis()
          && firestore.get(path).data.get('status', '') in ['active', 'trialing', 'grace_period', 'canceling', 'past_due']
          && firestore.get(path).data.get('idleScreenCustomization', '') == 'custom'
          && firestore.get(path).data.get('canUseCenterLogo', false) == true);
    }
    // Only the verified center owner can fetch original template PNGs. The
    // operator uploads immutable objects without public download tokens.
    match /center-templates/{centerId}/{templateId}/{fileName} {
      allow get: if request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isOwner(request.auth.uid)
        && centerId.matches('^[A-Za-z0-9_-]{1,120}$')
        && templateId.matches('^[A-Za-z0-9_-]{1,120}$')
        && fileName.matches('^[a-f0-9]{64}[.]png$')
        && firestore.exists(/databases/(default)/documents/centers/$(centerId))
        && firestore.get(/databases/(default)/documents/centers/$(centerId)).data.ownerUid == request.auth.uid;
      allow list, write: if false;
    }

    match /users/{userId}/profile/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && (request.resource == null
          || (request.resource.size < 5 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /users/{userId}/brand/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && canCustomizeBrand(userId)
        && (request.resource == null
          || (request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }

    match /users/{userId}/support/{requestId}/{fileId} {
      function permit() {
        return firestore.get(/databases/(default)/documents/users/$(userId)/supportUploads/$(requestId)).data;
      }
      // A missing own object must be distinguishable for lost-upload responses.
      allow read: if isOwner(userId) || (request.auth != null
        && request.auth.token.get('supportOperator', false) == true
        && !firestore.exists(/databases/(default)/documents/accountDeletions/$(userId)));
      allow create: if resource == null && isOwner(userId)
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && requestId.matches('^[A-Za-z0-9_-]{8,80}$')
        && fileId.matches('^[A-Za-z0-9_-]{8,80}$')
        && !firestore.exists(/databases/(default)/documents/users/$(userId)/supportTickets/$(requestId))
        && firestore.exists(/databases/(default)/documents/users/$(userId)/supportUploads/$(requestId))
        && permit().status == 'ready'
        && permit().expiresAtMs > request.time.toMillis()
        && permit().path == 'users/' + userId + '/support/' + requestId + '/' + fileId
        && request.resource.size > 0 && request.resource.size <= 5 * 1024 * 1024
        && request.resource.size == permit().sizeBytes
        && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp']
        && request.resource.contentType == permit().contentType
        && request.resource.metadata.sha256 == permit().sha256;
      allow update, delete: if false;
    }

    match /users/{userId}/workouts/{workoutId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId)
        && (request.resource == null
          || (request.resource.size < 10 * 1024 * 1024
            && request.resource.contentType.matches('image/.*')));
    }
  }
}
