{
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "cloud-board-stationd",
          "appId": "1:428540903054:android:372a37e13694a69b3d93df",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "cloud-board-stationd",
          "appId": "1:428540903054:ios:2483df8a16e997ba3d93df",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "cloud-board-stationd",
          "configurations": {
            "android": "1:428540903054:android:372a37e13694a69b3d93df",
            "ios": "1:428540903054:ios:2483df8a16e997ba3d93df",
            "web": "1:428540903054:web:c9deb3b356dbbf793d93df"
          }
        }
      }
    }
  }
}
