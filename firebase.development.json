{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "database": {
    "instance": "cloud-board-development-default-rtdb",
    "rules": "database.rules.json"
  },
  "hosting": {
    "site": "cloud-board-development",
    "public": "build/web",
    "ignore": [
      "firebase.development.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "storage": [
    {
      "bucket": "cloud-board-development.firebasestorage.app",
      "rules": "storage.rules"
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "account-deletion",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        ".secret*",
        "*-debug.log",
        "test"
      ]
    },
    {
      "source": "build/development-display-functions",
      "codebase": "cloudboard-auth",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", ".env*", ".secret*", "*-debug.log", "test"]
    }
  ]
}
