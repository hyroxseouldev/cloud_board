rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId
        && !exists(/databases/$(database)/documents/accountDeletions/$(userId));
    }

    match /subscriptionEntitlements/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Public, non-sensitive release policy; all mutations are Admin SDK only.
    match /appReleases/{platform} {
      allow read: if platform in ['ios', 'android'];
      allow write: if false;
    }

    // Editorial release summaries only. No build logs, credentials or user data.
    match /appContent/updateNews {
      allow get: if true;
      allow list, write: if false;
    }

    match /runtimePolicy/current {
      allow get: if request.auth != null;
      allow list, write: if false;
    }

    // Center templates are operator-published. Display identities and client
    // claims do not grant access to another center's authoring materials.
    function ownsTemplateCenter(centerId) {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && isOwner(request.auth.uid)
        && exists(/databases/$(database)/documents/centers/$(centerId))
        && get(/databases/$(database)/documents/centers/$(centerId)).data.ownerUid == request.auth.uid;
    }
    match /centers/{centerId}/slideTemplateCatalog/current {
      allow get: if ownsTemplateCenter(centerId);
      allow list, write: if false;
    }

    // Only server-produced generation records; clients cannot forge complete
    // jobs, mutate reservations or access another account/center's source.
    match /users/{userId}/templateGenerationCenters/{centerId}/jobs/{jobId} {
      allow read: if isOwner(userId) && ownsTemplateCenter(centerId)
        && get(/databases/$(database)/documents/users/$(userId)/onboarding/progress).data.storeId == centerId;
      allow write: if false;
    }

    function validSound(v) {
      return v in ['silent', 'gentleBeep', 'classicBeep', 'sharpBeep', 'lowPulse',
        'boxingBell', 'softBell', 'doubleBeep', 'longFinish', 'videoBeep'];
    }
    function validPreferences(p) {
      return p is map && p.keys().hasOnly(['brandL', 'brandR', 'soundTheme',
          'countdownSound', 'workStartSound', 'restStartSound', 'workoutEndSound', 'soundVolume', 'countdown'])
        && p.brandL is string && p.brandR is string
        && p.brandL.size() <= 2000 && p.brandR.size() <= 2000
        && p.soundTheme in ['videoBeep', 'simple', 'classic', 'boxing', 'studio', 'custom']
        && validSound(p.countdownSound) && validSound(p.workStartSound)
        && validSound(p.restStartSound) && validSound(p.workoutEndSound)
        && p.soundVolume is number && p.soundVolume >= 0 && p.soundVolume <= 1
        && p.countdown is map
        && p.countdown.keys().hasOnly(['seconds', 'backgroundColor', 'imageSource', 'appearance'])
        && p.countdown.seconds is int && p.countdown.seconds >= 0 && p.countdown.seconds <= 60
        && p.countdown.backgroundColor is int && p.countdown.imageSource is string
        && p.countdown.appearance is map
        && validCountdownAppearance(p.countdown.appearance);
    }
    function validCountdownAppearance(a) {
      return a.keys().hasOnly(['showReady', 'showTitle', 'numberScale', 'numberFormat',
          'numberColor', 'numberShadow', 'overlayEnabled', 'overlayOpacity', 'overlayColor'])
        && a.showReady is bool && a.showTitle is bool && a.numberShadow is bool
        && a.numberScale is number && a.numberScale >= 0.5 && a.numberScale <= 1.8
        && a.numberFormat in ['seconds', 'clock'] && a.overlayEnabled is bool
        && (a.numberColor == null || a.numberColor is int)
        && (a.overlayColor == null || a.overlayColor is int)
        && (a.overlayOpacity == null || (a.overlayOpacity is number && a.overlayOpacity >= 0 && a.overlayOpacity <= 1));
    }
    function validSettings(d) {
      return d.keys().hasOnly(['schemaVersion', 'revision', 'updatedAt', 'contentOnly', 'preferences'])
        && d.schemaVersion == 1 && d.revision is int && d.updatedAt == request.time
        && d.contentOnly is bool && validPreferences(d.preferences);
    }
    // During coexistence, installed clients still write these profile fields.
    // Accept the same bounded values; an idempotent server bridge synchronizes
    // the canonical document. This grants no subscription or ownership access.
    function compatibleProfileWrite(userId) {
      let changes = request.resource.data.diff(resource.data).affectedKeys();
      return (!changes.hasAny(['workoutSettings'])
          || validPreferences(request.resource.data.workoutSettings))
        && (!changes.hasAny(['countdownDefaults'])
          || validPreferences({
            'brandL': '', 'brandR': '', 'soundTheme': 'videoBeep',
            'countdownSound': 'videoBeep', 'workStartSound': 'videoBeep',
            'restStartSound': 'videoBeep', 'workoutEndSound': 'videoBeep',
            'soundVolume': 1, 'countdown': request.resource.data.countdownDefaults}));
    }
    function validAiSlideColor(color) {
      return color == null || (color is int && color >= 0 && color <= 4294967295);
    }
    function validAiSlideDesignStyle(s) {
      return s == null || (s is map
        && s.keys().hasOnly(['version', 'family', 'fontFamily', 'titleColor', 'titleWeight', 'motif', 'originalTemplate'])
        && s.get('originalTemplate', null) in [null, 'dolpa-brick-v1', 'stationd-mon-v1', 'stationd-tue-v1', 'stationd-wed-v1', 'stationd-thu-v1', 'stationd-fri-v1', 'stationd-sat-v1']
        && s.get('version', 1) == 1
        && s.get('family', 'banner') in ['banner', 'focus', 'editorial', 'cards']
        && s.get('fontFamily', 'sans') in ['sans', 'serif']
        && s.get('titleWeight', 900) in [400, 500, 600, 700, 800, 900]
        && s.get('motif', '') is string && s.get('motif', '').size() <= 12
        && (s.get('titleColor', null) == null || (s.titleColor is int
          && s.titleColor >= 4278190080 && s.titleColor <= 4294967295)));
    }
    function validAiSlideThemeValues(d) {
      return d is map && d.keys().hasOnly(['schemaVersion', 'designBackgroundColor', 'designTextColor',
          'designAccentColor', 'designLayout', 'designFontWeight', 'designItalic',
          'designSpacing', 'showTimer', 'timerX', 'timerY', 'timerSize', 'updatedAt', 'designStyle'])
        && d.schemaVersion == 1
        && validAiSlideDesignStyle(d.get('designStyle', null))
        && validAiSlideColor(d.designBackgroundColor)
        && validAiSlideColor(d.designTextColor) && validAiSlideColor(d.designAccentColor)
        && d.designLayout in ['auto', 'columns', 'cards']
        && d.designFontWeight in [400, 500, 600, 700, 800, 900]
        && d.designItalic is bool && d.showTimer is bool
        && d.designSpacing is number && d.designSpacing >= 0.8 && d.designSpacing <= 1.5
        && d.timerX is number && d.timerX >= 0 && d.timerX <= 1
        && d.timerY is number && d.timerY >= 0 && d.timerY <= 1
        && d.timerSize is number && d.timerSize >= 0.5 && d.timerSize <= 1.8;
    }
    function validAiSlideTheme(d) {
      return validAiSlideThemeValues(d) && d.updatedAt == request.time;
    }
    function validAiSlideDesignCenter(userId, storeId) {
      return storeId == null || (storeId is string && storeId.size() > 0 && storeId.size() <= 120
        && storeId.matches('^[A-Za-z0-9_-]+$')
        && exists(/databases/$(database)/documents/centers/$(storeId))
        && get(/databases/$(database)/documents/centers/$(storeId)).data.ownerUid == userId);
    }
    function validAiSlideDesign(d, userId) {
      return d.keys().hasOnly(['schemaVersion', 'name', 'description', 'storeId', 'theme', 'updatedAt'])
        && d.schemaVersion == 1
        && d.name is string && d.name.size() > 0 && d.name.size() <= 60
        && d.description is string && d.description.size() <= 160
        && validAiSlideDesignCenter(userId, d.storeId)
        && validAiSlideThemeValues(d.theme) && !d.theme.keys().hasAny(['updatedAt'])
        && d.updatedAt == request.time;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId
        && !request.resource.data.keys().hasAny(['partnerTier', 'subscriptionPlan', 'subscriptionStatus', 'displayLimit', 'pilotStartedAt', 'pilotEndsAt']);
      allow update: if isOwner(userId) && request.resource.data.uid == userId
        && compatibleProfileWrite(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['partnerTier', 'subscriptionPlan', 'subscriptionStatus', 'displayLimit', 'pilotStartedAt', 'pilotEndsAt']);

      // Cloud Function validates item conflicts and account-wide saved-slide limits.
      match /billing/summary {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /{collection}/{itemId} {
        allow read: if collection in ['slideTemplates', 'slideStyles', 'libraryState', 'libraryFolders'] && isOwner(userId);
        allow write: if false;
      }
      match /settings/workout {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validSettings(request.resource.data)
          && request.resource.data.revision == 1 && request.resource.data.contentOnly == false;
        allow update: if isOwner(userId) && validSettings(request.resource.data)
          && request.resource.data.revision == resource.data.revision + 1
          && request.resource.data.contentOnly == resource.data.contentOnly;
        // Compatibility migrations are Admin SDK only; installed writers remain supported.
        allow delete: if false;
      }
      // A visual preset shared by this account's signed-in devices. Lesson
      // content, subscription fields and generated prompts are never stored here.
      match /settings/aiSlidesTheme {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validAiSlideTheme(request.resource.data);
      }
      // Named design templates have a dedicated collection. Saved WorkoutModule
      // styles remain server-only and keep their existing wire contract.
      match /aiSlideDesigns/{designId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && designId.size() > 0 && designId.size() <= 120 && designId.matches('^[A-Za-z0-9_-]+$')
          && validAiSlideDesign(request.resource.data, userId);
      }
      // Only callables create tickets; users/operators cannot alter evidence or
      // notification state. Private outbox/config collections have no client grant.
      match /supportTickets/{requestId} {
        allow read: if isOwner(userId) || (request.auth != null
          && request.auth.token.get('supportOperator', false) == true
          && !exists(/databases/$(database)/documents/accountDeletions/$(userId)));
        allow write: if false;
      }
      match /planUsage/{documentId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
      match /catalog/{documentId} {
        allow read: if isOwner(userId);
        // Only the verified admin migration can activate a complete catalog.
        allow write: if false;
      }
      match /workoutSummaries/{workoutId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['id', 'name', 'folder', 'imageSource', 'moduleCount', 'durationSeconds', 'durationKind', 'updatedAt'])
          && request.resource.data.id == workoutId
          && request.resource.data.name is string
          && request.resource.data.folder is string
          && request.resource.data.imageSource is string
          && request.resource.data.moduleCount is int
          && request.resource.data.moduleCount >= 0
          && request.resource.data.durationSeconds is int
          && request.resource.data.get('durationKind', 'fixed') in ['fixed', 'maximum', 'open']
          && request.resource.data.updatedAt is timestamp
          && getAfter(/databases/$(database)/documents/users/$(userId)/workouts/$(workoutId)).data.ownerId == userId;
      }
      // Module designFingerprint is an optional renderer-version/hash hint.
      // Both old modules without it and new DTOs retain the same owner checks.
      // It grants no asset permission; Storage and the scoped client lookup do.
      match /workouts/{workoutId} {
        allow read, delete: if isOwner(userId);
        // Legacy accounts remain compatible until their server-owned policy
        // projection activates v2. All v2 creates use saveWorkout atomically.
        allow create: if isOwner(userId)
          && (!exists(/databases/$(database)/documents/subscriptionEntitlements/$(userId))
            || get(/databases/$(database)/documents/subscriptionEntitlements/$(userId)).data.get('policyVersion', '') != 'plan-entitlements-v2')
          && request.resource.data.ownerId == userId
          && request.resource.data.author.id == userId
          && request.resource.data.id == workoutId;
        allow update: if isOwner(userId)
          && request.resource.data.ownerId == userId
          && request.resource.data.author.id == userId
          && request.resource.data.id == workoutId
          && request.resource.data.createdAt == resource.data.createdAt;
      }
    }
  }
}
