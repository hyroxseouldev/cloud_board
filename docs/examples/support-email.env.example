# Copy only into the intended Functions project's private .env.<project-id>.
# Both flags default off. Development mail stays off unless explicitly reviewed.
SUPPORT_EMAIL_SECRETS_ENABLED=false
SUPPORT_EMAIL_DELIVERY_ENABLED=false
# SUPPORT_EMAIL_API_KEY is a Secret Manager value, never a literal .env entry.
# Separately create server-only Firestore supportConfig/email using the contract
# in docs/support-tickets.md. Do not commit provider credentials or copy prod keys.
